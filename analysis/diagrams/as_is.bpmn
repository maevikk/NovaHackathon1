<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_ProcessLab" targetNamespace="https://processlab.local/bpmn"><bpmn:process id="Process_Venio" name="Гипотетическая оркестрация сборки VENIO-C · требуется согласование маршрута" isExecutable="false"><bpmn:startEvent id="start" name="План/комплекты" /><bpmn:parallelGateway id="split" name="Параллельные подсборки" /><bpmn:task id="op1" name="РМ1 корпус и низ" /><bpmn:task id="op2" name="РМ2 корпус и верх" /><bpmn:task id="op3" name="РМ3 дроссель" /><bpmn:task id="op5" name="РМ5 мембрана" /><bpmn:task id="op6" name="РМ6 пробка" /><bpmn:parallelGateway id="join4" name="Соединение 2+3" /><bpmn:task id="op4" name="РМ4 тарелка и дроссель" /><bpmn:parallelGateway id="join7" name="Соединение 4+5+6" /><bpmn:task id="op7" name="РМ7 пульт" /><bpmn:task id="op8" name="РМ8 6 болтов" /><bpmn:task id="op9" name="РМ9 штуцеры" /><bpmn:task id="qc" name="ОТК" /><bpmn:endEvent id="end" name="Сдача заказчику" /><bpmn:sequenceFlow id="flow_1" sourceRef="start" targetRef="split" /><bpmn:sequenceFlow id="flow_2" sourceRef="split" targetRef="op1" /><bpmn:sequenceFlow id="flow_3" sourceRef="split" targetRef="op3" /><bpmn:sequenceFlow id="flow_4" sourceRef="split" targetRef="op5" /><bpmn:sequenceFlow id="flow_5" sourceRef="split" targetRef="op6" /><bpmn:sequenceFlow id="flow_6" sourceRef="op1" targetRef="op2" /><bpmn:sequenceFlow id="flow_7" sourceRef="op2" targetRef="join4" /><bpmn:sequenceFlow id="flow_8" sourceRef="op3" targetRef="join4" /><bpmn:sequenceFlow id="flow_9" sourceRef="join4" targetRef="op4" /><bpmn:sequenceFlow id="flow_10" sourceRef="op4" targetRef="join7" /><bpmn:sequenceFlow id="flow_11" sourceRef="op5" targetRef="join7" /><bpmn:sequenceFlow id="flow_12" sourceRef="op6" targetRef="join7" /><bpmn:sequenceFlow id="flow_13" sourceRef="j